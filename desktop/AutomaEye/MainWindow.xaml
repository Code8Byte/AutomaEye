<Window x:Class="AutomaEye.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutomaEye" Height="800" Width="1200" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,14" FontSize="16" FontWeight="Bold">
                    Automa<Run Foreground="{StaticResource AccentBrush}" Text="Eye"/>
                </TextBlock>
                <Button DockPanel.Dock="Top" Content="+ New project" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="NewProject_Click"/>
                <Button DockPanel.Dock="Top" Content="GitHub storage" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12" Click="GitHubStorage_Click"/>
                <ListBox x:Name="ProjectList" Background="Transparent" BorderThickness="0" SelectionChanged="ProjectList_SelectionChanged" DisplayMemberPath="Name"/>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1" x:Name="MainArea" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProjectTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Delete project" Style="{StaticResource DangerButton}" Click="DeleteProject_Click"/>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="20">
                <TabItem Header="Models">
                    <StackPanel Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="+ Add model" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddModel_Click"/>
                            <Button Content="+ Load existing model" Style="{StaticResource SecondaryButton}" Click="LoadModel_Click" ToolTip="Already have a trained .onnx? Register it without training in-app."/>
                        </StackPanel>
                        <ItemsControl x:Name="ModelsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TrainedLabel}" Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Import images" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="ImportImages_Click" Tag="{Binding Name}" ToolTip="Add images to this model's training/validation dataset"/>
                                                    <Button Content="Augment" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="AugmentModel_Click" Tag="{Binding Name}"/>
                                                    <Button Content="Auto-tune confidence" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="CalibrateModel_Click" Tag="{Binding Name}" ToolTip="Sweep confidence thresholds against the val split and pick the one with the best F1 score"/>
                                                    <Button Content="Calibrate" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="GdtCalibrate_Click" Tag="{Binding Name}" Visibility="{Binding IsGdt, Converter={StaticResource BoolToVis}}" ToolTip="Manual pixel-to-mm calibration for GD&amp;T measurement (no sensor needed)"/>
                                                    <Button Content="Aturan (add-ons)" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="ConfigureAddons_Click" Tag="{Binding Name}" Visibility="{Binding HasAddonConfig, Converter={StaticResource BoolToVis}}" ToolTip="Configure Count / GD&amp;T per-class tolerances"/>
                                                    <Button Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteModel_Click" Tag="{Binding Name}"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding GdtStatus}" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,6,0,0" Visibility="{Binding IsGdt, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Workflow">
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,14" MaxWidth="640"
                                   Text="Five stages, each optional - leave any of them empty if this line doesn't need it. Models run in this fixed order regardless of when you assign them."/>
                        <ItemsControl x:Name="CategorySlots">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StageName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Clear" Style="{StaticResource DangerButton}" Click="ClearSlot_Click" Tag="{Binding Category}"
                                                        Visibility="{Binding HasAssignment, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Options}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Label}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AssignSlot_Click" Tag="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Output">
                    <StackPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="How should each OK/NG result be sent out?" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="OutputModeSignalButton" Content="Fixed serial signal (0 = OK, 1 = NG)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OutputModeButton_Click" Tag="signal"/>
                            <Button x:Name="OutputModeScriptButton" Content="Custom code" Style="{StaticResource SecondaryButton}" Click="OutputModeButton_Click" Tag="script"/>
                        </StackPanel>
                        <TextBlock x:Name="SignalInfoText" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                                   Text="Sends a fixed byte over the serial port configured on the Run tab - &quot;1&quot; on NG, &quot;0&quot; on OK if 'signal on OK' is enabled there. No code needed."/>
                        <StackPanel x:Name="ScriptPanel" Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"
                                       Text="Runs your JavaScript's onResult(result) for every inspection result. Call serial_write(str) to drive Arduino/PLC over the serial port set on the Run tab, http_post(url, body) to hit an HTTP endpoint, or do anything else the line needs."/>
                            <TextBox x:Name="ScriptTextBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" Height="260" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Test" Style="{StaticResource SecondaryButton}" Click="TestScript_Click"/>
                                <TextBlock x:Name="TestResultText" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="SaveOutput_Click"/>
                            <TextBlock x:Name="OutputSavedText" Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center" Text="Saved" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Run">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="480"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <Border Background="Black" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Width="480" Height="360">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                                    <TextBlock x:Name="PreviewIdleText" Text="Camera is off - click Preview or Start inspection"
                                               Foreground="{StaticResource TextDimBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300"/>
                                </Grid>
                            </Border>
                            <Button Content="Preview (one frame)" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="PreviewOnce_Click"
                                    ToolTip="Grabs a single frame to check framing - the camera stays off otherwise, this is an edge-computing device"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0" MaxWidth="320" HorizontalAlignment="Left">
                            <TextBlock Text="Camera" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="CameraList" Margin="0,0,0,14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="CameraButton_Click" Tag="{Binding Index}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="VerdictBadge" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="10,16" Margin="0,0,0,14">
                                <TextBlock x:Name="VerdictText" Text="IDLE" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Margin="0,0,4,0" Padding="8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TotalCountText" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <TextBlock Text="TOTAL" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Margin="4,0" Padding="8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="OkCountText" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <TextBlock Text="OK" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Margin="4,0,0,0" Padding="8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="NgCountText" Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                        <TextBlock Text="NG" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Button x:Name="ToggleRunButton" Content="Start inspection" Style="{StaticResource PrimaryButton}" Click="ToggleRun_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock x:Name="EmptyStateText" Grid.Column="1" Text="Select or create a project to get started."
                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
