<Window x:Class="AutomaEye.GitHubSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutomaEye - GitHub Storage" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="GitHub project storage" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,14"
                   Text="Every project (dataset, trained model, workflow) lives as a subfolder here and syncs to the GitHub repo you choose - private or public, your call. Large files (images, .onnx/.pt weights) go through Git LFS automatically."/>

        <TextBlock Text="Repo URL (e.g. https://github.com/you/your-repo.git)" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="RepoUrlInput" Margin="0,0,0,10"/>
        <Button Content="Connect" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,14" Click="Connect_Click"/>

        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Push (upload local changes)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Push_Click"/>
            <Button Content="Pull (get latest from GitHub)" Style="{StaticResource SecondaryButton}" Click="Pull_Click"/>
        </StackPanel>

        <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="11" Height="180" VerticalScrollBarVisibility="Auto"
                 Background="#0B0E16"/>

        <Button Content="Close" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
