<Window x:Class="AutomaEye.AiAssistantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutomaEye - AI Assistant" Width="720" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Report">
                <StackPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <DatePicker x:Name="ReportDatePicker" Margin="0,0,10,0"/>
                        <Button Content="Generate Report" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="GenerateReport_Click"/>
                        <Button Content="Generate Excel Deteksi" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="GenerateXlsx_Click"/>
                        <Button x:Name="OpenXlsxButton" Content="Buka XLSX" Style="{StaticResource SecondaryButton}" Click="OpenXlsx_Click" IsEnabled="False"/>
                    </StackPanel>
                    <Border Background="Black" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer Height="440" Padding="10">
                            <TextBlock x:Name="ReportText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#d0d0d0"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Analyze NG">
                <StackPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <DatePicker x:Name="AnalyzeDatePicker" Margin="0,0,10,0"/>
                        <Button Content="Analyze NG Pattern" Style="{StaticResource PrimaryButton}" Click="Analyze_Click"/>
                    </StackPanel>
                    <Border Background="Black" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer Height="440" Padding="10">
                            <TextBlock x:Name="AnalyzeText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#d0d0d0"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Chat">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                        <ScrollViewer x:Name="ChatScroll" Padding="10">
                            <TextBlock x:Name="ChatText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#d0d0d0"/>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ChatInput" AcceptsReturn="True" Height="60" Margin="0,0,8,0" VerticalScrollBarVisibility="Auto"/>
                        <Button Grid.Column="1" x:Name="ChatSendButton" Content="Send" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Send_Click"/>
                        <Button Grid.Column="2" Content="Clear" Style="{StaticResource SecondaryButton}" Click="ClearChat_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
