<Window x:Class="AutomaEye.GdtCalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutomaEye - GD&amp;T Calibration" Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Manual calibration (no measurement sensor)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12"
                   Text="Click two points on a known reference (e.g. a ruler or a part with a known dimension) in the frame below, then enter the real-world distance between them."/>

        <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="Black" Height="360">
            <Grid>
                <Image x:Name="FrameImage" Stretch="Uniform" MouseLeftButtonDown="FrameImage_MouseLeftButtonDown"/>
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <TextBlock x:Name="HintText" Margin="0,8,0,12" Foreground="{StaticResource TextDimBrush}" Text="Click the first point."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Known distance between points:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="DistanceInput" Width="100"/>
            <TextBlock Text="mm" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Recapture frame" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Recapture_Click"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Content="Save calibration" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
