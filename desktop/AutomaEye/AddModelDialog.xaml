<Window x:Class="AutomaEye.AddModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutomaEye - New Model" Width="640" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <!-- Fixed size rather than SizeToContent: with a WrapPanel of variable-
         width CheckBoxes below, SizeToContent measured before the wrap was
         resolved and clipped the dialog. Vertical-only scroll is a fallback
         if a future longer addon list overflows - horizontal scroll must
         stay off, since it gives children infinite width during layout and
         the WrapPanel below would never wrap at all. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20">
        <TextBlock Text="New Model - AI Tools x Rule-based Tools" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TextBlock Text="Application-specific AI Tools (pilih 1)" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,18">
            <Button x:Name="TypeSegmentationButton" Content="AI Segmentation" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Click="TypeButton_Click" Tag="Segmentation"/>
            <Button x:Name="TypeDetectionButton" Content="AI Detection" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="TypeButton_Click" Tag="Detection"/>
            <Button x:Name="TypeClassificationButton" Content="AI Classification" Style="{StaticResource SecondaryButton}" Margin="0,6,6,0" Click="TypeButton_Click" Tag="Classification"/>
            <Button x:Name="TypeOcrButton" Content="AI OCR" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0" Click="TypeButton_Click" Tag="OCR"/>
        </UniformGrid>

        <TextBlock Text="Rule-based Tools (opsional, kombinasikan dengan AI)" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,8"
                   Text="Tools yang bertanda (belum aktif) belum punya logika evaluasi - bisa dipilih untuk dokumentasi/rencana ke depan, tapi tidak memengaruhi verdict OK/NG saat ini."/>
        <WrapPanel Margin="0,0,0,4">
            <CheckBox x:Name="AddonPresenceCheck" Content="Presence Check" Margin="0,0,16,8"/>
            <CheckBox x:Name="AddonScratches" Content="Scratches (belum aktif)" Margin="0,0,16,8"/>
            <CheckBox x:Name="AddonGdt" Content="GD&amp;T Measurement" Margin="0,0,16,8"/>
            <CheckBox x:Name="AddonPositioning" Content="Positioning (belum aktif)" Margin="0,0,16,8"/>
            <CheckBox x:Name="AddonColorInspection" Content="Color Inspection (belum aktif)" Margin="0,0,16,8"/>
            <CheckBox x:Name="AddonCount" Content="Count" Margin="0,0,16,8" Checked="AddonCount_CheckedChanged" Unchecked="AddonCount_CheckedChanged"/>
            <CheckBox x:Name="AddonCharacterRecognition" Content="Character Recognition (belum aktif)" Margin="0,0,16,8"/>
            <CheckBox x:Name="AddonCode1D" Content="1D Code (belum aktif)" Margin="0,0,16,8"/>
            <CheckBox x:Name="AddonCode2D" Content="2D Code (belum aktif)" Margin="0,0,16,8"/>
            <CheckBox x:Name="AddonCalibration" Content="Calibration (belum aktif)" Margin="0,0,16,8"/>
        </WrapPanel>

        <StackPanel x:Name="CountConfigPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="Jumlah objek yang diharapkan (Count):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="CountExpectedInput" Width="80" Text="1"/>
        </StackPanel>

        <TextBlock Text="Model Info" FontWeight="SemiBold" Margin="0,4,0,8"/>
        <TextBlock Text="Nama" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="NameInput" Margin="0,0,0,12"/>

        <TextBlock Text="Kelas, dipisah koma (mis. OK, waterspot, scratch, rust)" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="ClassesInput" Text="OK" Margin="0,0,0,16"/>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Batal" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Create Model" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Window>
