<Window x:Class="AutomaEye.EvaluateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutomaEye - Test / Evaluate" Width="760" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="SplitTestButton" Content="Test" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="SplitButton_Click" Tag="test"/>
            <Button x:Name="SplitValButton" Content="Val" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="SplitButton_Click" Tag="val"/>
            <Button x:Name="SplitTrainButton" Content="Train" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0" Click="SplitButton_Click" Tag="train"/>
            <Button x:Name="RunButton" Content="Jalankan Test" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="Run_Click"/>
            <Button x:Name="OpenFolderButton" Content="Buka folder hasil" Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" IsEnabled="False"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock x:Name="OverallText" FontSize="13" Margin="0,10,0,10" TextWrapping="Wrap"/>
                <TextBlock Text="Edge Computing - Waktu Inferensi (ms, per-stage)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TimingText" FontFamily="Consolas" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"/>
                <TextBlock Text="Per-class metrics" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="PerClassText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="LogText" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap" MaxHeight="80"/>
    </Grid>
</Window>
