<Window x:Class="AutomaEye.TrainDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutomaEye - Train" Width="700" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="DatasetStatusText" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,14"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Epochs" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="EpochsInput"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Batch" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="BatchInput"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Image size" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="ImgSizeInput"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Learning rate" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="LearnRateInput"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="Black" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="10">
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11" Foreground="#a0f0c0" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" x:Name="ProgressBarCtl" Height="8" Minimum="0" Maximum="100" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" x:Name="ProgressText" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="MetricsText" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" x:Name="ResumeButton" Content="Resume" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Resume_Click" Visibility="Collapsed"/>
            <Button Grid.Column="2" x:Name="StartButton" Content="Start Training" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Start_Click"/>
            <Button Grid.Column="3" x:Name="CancelButton" Content="Cancel" Style="{StaticResource DangerButton}" Click="Cancel_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
