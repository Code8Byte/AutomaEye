<Window x:Class="AutomaEye.AnnotationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutomaEye - Annotation" Width="600" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,16"/>

        <TextBlock Text="Server" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Start Label Studio Server" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="StartServer_Click"/>
            <Button Content="Stop Server" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="StopServer_Click"/>
            <Button Content="Test Token" Style="{StaticResource SecondaryButton}" Click="TestToken_Click"/>
        </StackPanel>

        <TextBlock Text="Auto-Setup" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,8"
                   Text="Creates a Label Studio project pre-configured for this model's AI type (bbox/polygon/choice/text template), and uploads its train images."/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Auto-Setup Project" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="AutoSetup_Click"/>
            <Button x:Name="OpenLabelingButton" Content="Buka Halaman Labeling" Style="{StaticResource SecondaryButton}" Click="OpenLabeling_Click" IsEnabled="False"/>
        </StackPanel>

        <TextBlock Text="Sync" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="SyncButton" Content="Sync Labels (YOLO)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Sync_Click" IsEnabled="False"/>
            <Button Content="Buka Folder Dataset" Style="{StaticResource SecondaryButton}" Click="OpenDatasetFolder_Click"/>
        </StackPanel>

        <TextBlock x:Name="LogText" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="11"/>
    </StackPanel>
</Window>
